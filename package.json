{
  "name": "magpie-strip-harness",
  "version": "0.1.0",
  "description": "Magpie middleware for conservative, rule-based cleanup of harness identity prompts",
  "type": "module",
  "keywords": ["opencode", "opencode-plugin", "magpie", "middleware", "system-prompt"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonqianqiu/magpie-strip-harness.git"
  },
  "homepage": "https://github.com/moonqianqiu/magpie-strip-harness#readme",
  "bugs": {
    "url": "https://github.com/moonqianqiu/magpie-strip-harness/issues"
  },
  "magpie": {
    "middleware": "./strip.middleware.js",
    "options": {
      "rules": {
        "version": 1,
        "rules": [
          {
            "id": "deepseek.identity-opening",
            "roles": ["system"],
            "unit": "line",
            "match": { "type": "regex", "value": "^\\s*You are an AI agent powered by DeepSeek Harness\\.?\\s*$", "flags": "i" },
            "action": { "type": "delete" }
          },
          {
            "id": "zcode.identity-opening",
            "roles": ["system"],
            "unit": "line",
            "match": { "type": "regex", "value": "^\\s*You are ZCode, an interactive agent\\.?\\s*$", "flags": "i" },
            "action": { "type": "delete" }
          },
          {
            "id": "zcode.context-heading",
            "roles": ["system"],
            "unit": "line",
            "match": { "type": "regex", "value": "^\\s*# ZCode Desktop Context\\s*$", "flags": "i" },
            "action": { "type": "replace", "value": "# Desktop Context" }
          },
          {
            "id": "codexcli.identity-opening",
            "roles": ["developer"],
            "unit": "line",
            "match": { "type": "regex", "value": "^\\s*You are Codex, an agent based on GPT-5\\. You and the user share one workspace, and your job is to collaborate with them until their goal is genuinely handled\\.?\\s*$", "flags": "i" },
            "action": { "type": "replace", "value": "You are an agent. You and the user share one workspace, and your job is to collaborate with them until their goal is genuinely handled." }
          },
          {
            "id": "codexcli.cli-identity-opening",
            "roles": ["developer"],
            "unit": "line",
            "match": { "type": "regex", "value": "^\\s*You are a coding agent running in the Codex CLI, a terminal-based coding assistant\\. Codex CLI is an open source project led by OpenAI\\. You are expected to be precise, safe, and helpful\\.?\\s*$", "flags": "i" },
            "action": { "type": "replace", "value": "You are a coding agent. You are expected to be precise, safe, and helpful." }
          },
          {
            "id": "codexcli.persona-opening",
            "roles": ["developer"],
            "unit": "span",
            "match": { "type": "contains", "value": "As Codex, you are" },
            "action": { "type": "replace", "value": "You are" }
          },
          {
            "id": "codexcli.context-clarifier",
            "roles": ["developer"],
            "unit": "line",
            "match": { "type": "regex", "value": "^\\s*Within this context, Codex refers to the open-source agentic coding interface \\(not the old Codex language model built by OpenAI\\)\\.?\\s*$", "flags": "i" },
            "action": { "type": "delete" }
          }
        ]
      },
      "debug": false
    }
  }
}
