{
  "name": "magpie-strip-harness",
  "version": "0.1.0",
  "description": "magpie gateway middleware: config-driven stripping of harness identity prompts from the system role of agent requests",
  "type": "module",
  "keywords": ["opencode", "opencode-plugin", "magpie", "middleware", "system-prompt"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aqiu817/magpie-strip-harness.git"
  },
  "homepage": "https://github.com/aqiu817/magpie-strip-harness#readme",
  "bugs": {
    "url": "https://github.com/aqiu817/magpie-strip-harness/issues"
  },
  "magpie": {
    "middleware": "./strip.middleware.js",
    "options": {
      "patterns": [
        "/deepseek[\\s_-]*harness/i",
        { "match": "/You are ZCode, an interactive agent/i" },
        { "match": "/^# ZCode Desktop Context\\s*$/i", "replace": "# Desktop Context" },
        { "match": "/window\\.zcode/i", "replace": "window" },
        { "match": ".zcode" },
        { "match": "/[._-]*z[._-]*code/i", "replace": "" }
      ],
      "stripAll": false,
      "debug": false
    }
  }
}
