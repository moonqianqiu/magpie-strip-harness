{
  "name": "magpie-strip-harness",
  "version": "0.1.0",
  "description": "Magpie middleware for conservative, rule-based cleanup of harness identity prompts",
  "type": "module",
  "keywords": ["opencode", "opencode-plugin", "magpie", "middleware", "system-prompt"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moonqianqiu/magpie-strip-harness.git"
  },
  "homepage": "https://github.com/moonqianqiu/magpie-strip-harness#readme",
  "bugs": {
    "url": "https://github.com/moonqianqiu/magpie-strip-harness/issues"
  },
  "magpie": {
    "middleware": "./strip.middleware.js",
    "options": {
      "rules": {
        "version": 1,
        "rules": [
          {
            "id": "deepseek.identity-opening",
            "roles": ["system"],
            "unit": "line",
            "match": { "type": "regex", "value": "^\\s*You are an AI agent powered by DeepSeek Harness\\.?\\s*$", "flags": "i" },
            "action": { "type": "delete" }
          },
          {
            "id": "zcode.identity-opening",
            "roles": ["system"],
            "unit": "line",
            "match": { "type": "regex", "value": "^\\s*You are ZCode, an interactive agent\\.?\\s*$", "flags": "i" },
            "action": { "type": "delete" }
          },
          {
            "id": "zcode.context-heading",
            "roles": ["system"],
            "unit": "line",
            "match": { "type": "regex", "value": "^\\s*# ZCode Desktop Context\\s*$", "flags": "i" },
            "action": { "type": "replace", "value": "# Desktop Context" }
          }
        ]
      },
      "debug": false
    }
  }
}
